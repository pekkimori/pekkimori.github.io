---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import RetroDesktop from "@/components/about/RetroDesktop";
import KonamiCat from "@/components/about/KonamiCat";
---

<Layout lang="en" title="About · Rafael Mori">
  <Header />
  <main id="main-content" data-layout="about">
    <h1 class="sr-only">About Rafael Mori</h1>
    <RetroDesktop client:load lang="en" />
    <KonamiCat client:idle />
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    if (
      document.querySelector("#main-content")?.getAttribute("data-layout") ===
      "about"
    ) {
      sessionStorage.setItem("backUrl", "/en/about");
    }
  });
</script>
