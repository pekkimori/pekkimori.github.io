---
import { SOCIALS } from "@/constants";
import LinkButton from "./LinkButton.astro";
import { SITE } from "@/config";
const isPt = Astro.url.pathname.startsWith("/pt/");
const linkTitle = (social: (typeof SOCIALS)[number]) => isPt
  ? social.name === "Mail"
    ? `Enviar um e-mail para ${SITE.title}`
    : `${SITE.title} no ${social.name}`
  : social.linkTitle;
---

<div class="flex flex-wrap items-center gap-1">
  {
    SOCIALS.map(social => (
      <LinkButton
        href={social.href}
        class="p-2 hover:rotate-6 sm:p-1"
        title={linkTitle(social)}
      >
        <social.icon class="inline-block size-6 scale-125 fill-transparent stroke-current stroke-2 opacity-90 group-hover:fill-transparent sm:scale-110" />
        <span class="sr-only">{linkTitle(social)}</span>
      </LinkButton>
    ))
  }
</div>
