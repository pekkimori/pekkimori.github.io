---
import BentoCard from "./BentoCard.astro";

const path = Astro.url.pathname;
const lang: "en" | "pt" | "ja" = path.startsWith("/pt")
  ? "pt"
  : path.startsWith("/ja")
    ? "ja"
    : "en";

const labels = {
  en: "Browse full shelf",
  pt: "Ver estante completa",
  ja: "本棚を見る",
};

const href = `/${lang}/bookshelf`;
---

<BentoCard prompt="$ ls ~/bookshelf">
  <div class="book-scene">
    <div class="book-pile" aria-hidden="true">
      <span class="scattered-book scattered-book-one"></span>
      <span class="scattered-book scattered-book-two"></span>
      <span class="scattered-book scattered-book-three"></span>
      <span class="scattered-book scattered-book-four"></span>
      <span class="scattered-book scattered-book-five"></span>
      <span class="scattered-book scattered-book-six"></span>
      <span class="scattered-book scattered-book-seven"></span>
      <span class="scattered-book scattered-book-eight"></span>
      <span class="scattered-book scattered-book-nine"></span>
      <span class="scattered-book scattered-book-ten"></span>
      <span class="scattered-book scattered-book-eleven"></span>
      <span class="scattered-book scattered-book-twelve"></span>
      <span class="scattered-book scattered-book-thirteen"></span>
      <span class="scattered-book scattered-book-fourteen"></span>
      <span class="scattered-book scattered-book-fifteen"></span>
      <span class="scattered-book scattered-book-sixteen"></span>
      <span class="scattered-book scattered-book-seventeen"></span>
      <span class="scattered-book scattered-book-eighteen"></span>
      <span class="scattered-book scattered-book-nineteen"></span>
      <span class="scattered-book scattered-book-twenty"></span>
      <span class="scattered-book scattered-book-twenty-one"></span>
      <span class="scattered-book scattered-book-twenty-two"></span>
      <span class="scattered-book scattered-book-twenty-three"></span>
      <span class="scattered-book scattered-book-twenty-four"></span>
    </div>
    <span class="floating-book-shadow" aria-hidden="true"></span>
    <a href={href} class="bookshelf-portal block" aria-label={labels[lang]}>
      <div class="book" aria-hidden="true">
        <span class="book-piece book-back"></span>
        <span class="book-piece book-endpaper">
          <i></i><i></i><i></i>
        </span>
        <span class="book-piece book-page book-page-three">
          <i></i><i></i><i></i>
        </span>
        <span class="book-piece book-page book-page-two">
          <i></i><i></i><i></i>
        </span>
        <span class="book-piece book-page book-page-one">
          <i></i><i></i><i></i>
        </span>
        <span class="book-piece book-cover">
          <span class="book-cover-mark">P</span>
          <span class="book-cover-rule"></span>
        </span>
        <span class="book-spine"></span>
      </div>
    </a>
  </div>
</BentoCard>

<style>
  .book-scene {
    position: relative;
    isolation: isolate;
    display: flex;
    height: 100%;
    min-height: 15rem;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--border) 78%, transparent);
    border-radius: 0.75rem;
    background:
      radial-gradient(
        circle at 50% 46%,
        color-mix(in srgb, var(--accent) 13%, transparent) 0,
        color-mix(in srgb, var(--accent) 5%, transparent) 20%,
        transparent 43%
      ),
      linear-gradient(
        145deg,
        color-mix(in srgb, var(--foreground) 3%, var(--background)),
        color-mix(in srgb, var(--accent) 3%, var(--background))
      );
    box-shadow: inset 0 0 2.5rem
      color-mix(in srgb, var(--foreground) 5%, transparent);
  }

  .book-scene::before {
    position: absolute;
    z-index: 0;
    inset: 0;
    background-image:
      linear-gradient(
        color-mix(in srgb, var(--foreground) 3%, transparent) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        color-mix(in srgb, var(--foreground) 3%, transparent) 1px,
        transparent 1px
      );
    background-size: 1.4rem 1.4rem;
    content: "";
    mask-image: radial-gradient(circle at center, transparent 12%, black 88%);
  }

  .book-pile {
    position: absolute;
    z-index: 1;
    inset: 0;
    pointer-events: none;
  }

  .scattered-book {
    --book-tone: color-mix(in srgb, var(--foreground) 9%, var(--background));
    --book-angle: 0deg;
    --book-scale: 1;

    position: absolute;
    width: 2.75rem;
    height: 3.9rem;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--foreground) 16%, var(--border));
    border-radius: 0.2rem 0.4rem 0.4rem 0.2rem;
    background: var(--book-tone);
    box-shadow: 0 0.35rem 0.8rem
      color-mix(in srgb, var(--foreground) 12%, transparent);
    opacity: 0.72;
    transform: rotate(var(--book-angle)) scale(var(--book-scale));
  }

  .scattered-book::before {
    position: absolute;
    inset-block: 0;
    left: 0.28rem;
    width: 0.2rem;
    background: color-mix(in srgb, var(--foreground) 14%, transparent);
    box-shadow: 1px 0 color-mix(in srgb, var(--background) 48%, transparent);
    content: "";
  }

  .scattered-book::after {
    position: absolute;
    top: 1.1rem;
    right: 0.45rem;
    left: 0.78rem;
    height: 1.15rem;
    border-block: 1px solid
      color-mix(in srgb, var(--foreground) 18%, transparent);
    background: linear-gradient(
        color-mix(in srgb, var(--foreground) 13%, transparent),
        color-mix(in srgb, var(--foreground) 13%, transparent)
      )
      center / 68% 1px no-repeat;
    content: "";
  }

  .scattered-book-one {
    --book-angle: -17deg;
    --book-tone: color-mix(in srgb, var(--accent) 14%, var(--background));

    top: -1.25rem;
    left: 1.1rem;
  }

  .scattered-book-two {
    --book-angle: 14deg;
    --book-tone: color-mix(in srgb, var(--foreground) 8%, var(--background));

    top: -1rem;
    right: 1.65rem;
  }

  .scattered-book-three {
    --book-angle: 27deg;
    --book-tone: color-mix(in srgb, var(--accent) 9%, var(--background));

    top: 4.25rem;
    left: -0.8rem;
  }

  .scattered-book-four {
    --book-angle: -23deg;
    --book-tone: color-mix(in srgb, var(--foreground) 11%, var(--background));

    top: 4.5rem;
    right: -0.65rem;
  }

  .scattered-book-five {
    --book-angle: -29deg;
    --book-tone: color-mix(in srgb, var(--foreground) 7%, var(--background));

    bottom: 3.3rem;
    left: 0.85rem;
  }

  .scattered-book-six {
    --book-angle: 26deg;
    --book-tone: color-mix(in srgb, var(--accent) 12%, var(--background));

    right: 1rem;
    bottom: 3.15rem;
  }

  .scattered-book-seven {
    --book-angle: 8deg;
    --book-tone: color-mix(in srgb, var(--accent) 8%, var(--background));

    bottom: -1.35rem;
    left: 4.6rem;
  }

  .scattered-book-eight {
    --book-angle: -10deg;
    --book-tone: color-mix(in srgb, var(--foreground) 10%, var(--background));

    right: 4.75rem;
    bottom: -1.2rem;
  }

  .scattered-book-nine {
    --book-angle: 9deg;
    --book-tone: color-mix(in srgb, var(--foreground) 6%, var(--background));

    top: 0.65rem;
    left: 40%;
    opacity: 0.48;
  }

  .scattered-book-ten {
    --book-angle: -7deg;
    --book-tone: color-mix(in srgb, var(--accent) 10%, var(--background));

    bottom: 0.45rem;
    left: 43%;
    opacity: 0.5;
  }

  .scattered-book-eleven {
    --book-angle: 31deg;
    --book-scale: 0.88;
    --book-tone: color-mix(in srgb, var(--foreground) 10%, var(--background));

    top: 1.9rem;
    left: 4.8rem;
    opacity: 0.62;
  }

  .scattered-book-twelve {
    --book-angle: -8deg;
    --book-scale: 0.93;
    --book-tone: color-mix(in srgb, var(--accent) 11%, var(--background));

    top: -1.15rem;
    left: 8.4rem;
    opacity: 0.58;
  }

  .scattered-book-thirteen {
    --book-angle: -30deg;
    --book-scale: 0.86;
    --book-tone: color-mix(in srgb, var(--accent) 8%, var(--background));

    top: 2rem;
    right: 4.85rem;
    opacity: 0.62;
  }

  .scattered-book-fourteen {
    --book-angle: 7deg;
    --book-scale: 0.92;
    --book-tone: color-mix(in srgb, var(--foreground) 12%, var(--background));

    top: -1.1rem;
    right: 8.35rem;
    opacity: 0.56;
  }

  .scattered-book-fifteen {
    --book-angle: -9deg;
    --book-scale: 0.84;
    --book-tone: color-mix(in srgb, var(--accent) 12%, var(--background));

    top: 5.7rem;
    left: 2.45rem;
    opacity: 0.58;
  }

  .scattered-book-sixteen {
    --book-angle: 12deg;
    --book-scale: 0.88;
    --book-tone: color-mix(in srgb, var(--foreground) 8%, var(--background));

    top: 5.9rem;
    right: 2.35rem;
    opacity: 0.6;
  }

  .scattered-book-seventeen {
    --book-angle: 18deg;
    --book-scale: 0.9;
    --book-tone: color-mix(in srgb, var(--foreground) 11%, var(--background));

    bottom: 4.45rem;
    left: 4.35rem;
    opacity: 0.62;
  }

  .scattered-book-eighteen {
    --book-angle: -16deg;
    --book-scale: 0.86;
    --book-tone: color-mix(in srgb, var(--accent) 10%, var(--background));

    right: 4.2rem;
    bottom: 4.4rem;
    opacity: 0.6;
  }

  .scattered-book-nineteen {
    --book-angle: 22deg;
    --book-scale: 0.92;
    --book-tone: color-mix(in srgb, var(--accent) 9%, var(--background));

    bottom: 0.4rem;
    left: 1.25rem;
    opacity: 0.55;
  }

  .scattered-book-twenty {
    --book-angle: -24deg;
    --book-scale: 0.9;
    --book-tone: color-mix(in srgb, var(--foreground) 9%, var(--background));

    right: 1.3rem;
    bottom: 0.35rem;
    opacity: 0.58;
  }

  .scattered-book-twenty-one {
    --book-angle: 36deg;
    --book-scale: 0.82;
    --book-tone: color-mix(in srgb, var(--foreground) 12%, var(--background));

    top: 8.55rem;
    left: -0.3rem;
    opacity: 0.52;
  }

  .scattered-book-twenty-two {
    --book-angle: -34deg;
    --book-scale: 0.84;
    --book-tone: color-mix(in srgb, var(--accent) 11%, var(--background));

    top: 8.45rem;
    right: -0.35rem;
    opacity: 0.54;
  }

  .scattered-book-twenty-three {
    --book-angle: -18deg;
    --book-scale: 0.88;
    --book-tone: color-mix(in srgb, var(--accent) 7%, var(--background));

    bottom: -1.25rem;
    left: 32%;
    opacity: 0.52;
  }

  .scattered-book-twenty-four {
    --book-angle: 16deg;
    --book-scale: 0.87;
    --book-tone: color-mix(in srgb, var(--foreground) 10%, var(--background));

    right: 32%;
    bottom: -1.15rem;
    opacity: 0.5;
  }

  .floating-book-shadow {
    position: absolute;
    z-index: 2;
    top: calc(50% + 2.15rem);
    left: 50%;
    width: 3.8rem;
    height: 0.7rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--foreground) 22%, transparent);
    filter: blur(0.38rem);
    opacity: 0.5;
    transform: translateX(-50%);
    animation: floating-shadow 4.2s ease-in-out infinite;
  }

  .bookshelf-portal {
    position: relative;
    z-index: 3;
    width: 4.25rem;
    height: 3.5rem;
    perspective: 700px;
    filter: drop-shadow(
      0 0.7rem 0.65rem color-mix(in srgb, var(--foreground) 18%, transparent)
    );
    animation: special-book-float 4.2s ease-in-out infinite;
  }

  .book {
    --book-hinge: calc(50% - 0.875rem);

    position: relative;
    width: 4.25rem;
    height: 3.5rem;
    flex: none;
    perspective: 420px;
    transform-style: preserve-3d;
    transition: transform 540ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .book-piece {
    position: absolute;
    top: 0.25rem;
    left: var(--book-hinge);
    width: 1.75rem;
    height: 3rem;
    transform-origin: left center;
    transform-style: preserve-3d;
    backface-visibility: hidden;
    border-radius: 0 0.3rem 0.3rem 0;
  }

  .book-back {
    z-index: 0;
    border: 1px solid color-mix(in srgb, var(--accent) 55%, var(--border));
    background: color-mix(in srgb, var(--accent) 35%, var(--background));
    transform: translateZ(-2px);
  }

  .book-endpaper,
  .book-page {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.55rem 0.35rem;
    border: 1px solid color-mix(in srgb, var(--foreground) 15%, var(--border));
    background: color-mix(in srgb, var(--background) 94%, var(--foreground));
    box-shadow: inset -0.2rem 0 0.35rem
      color-mix(in srgb, var(--foreground) 8%, transparent);
  }

  .book-page {
    --page-depth: 0px;

    backface-visibility: visible;
    transform: translateZ(var(--page-depth));
  }

  .book-endpaper i,
  .book-page i {
    display: block;
    height: 1px;
    background: color-mix(in srgb, var(--muted) 48%, transparent);
  }

  .book-endpaper i:nth-child(2),
  .book-page i:nth-child(2) {
    width: 72%;
  }

  .book-endpaper {
    z-index: 1;
    transform: translateZ(0);
  }

  .book-page-three {
    --page-depth: 1px;

    z-index: 2;
  }

  .book-page-two {
    --page-depth: 2px;

    z-index: 3;
  }

  .book-page-one {
    --page-depth: 3px;

    z-index: 4;
  }

  .book-cover {
    z-index: 5;
    display: grid;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--accent) 75%, var(--border));
    background:
      linear-gradient(
        90deg,
        color-mix(in srgb, var(--foreground) 14%, transparent) 0 12%,
        transparent 12%
      ),
      color-mix(in srgb, var(--accent) 28%, var(--background));
    box-shadow: 0.18rem 0.2rem 0.45rem
      color-mix(in srgb, var(--foreground) 16%, transparent);
    backface-visibility: visible;
    transform: translateZ(5px);
    transition: transform 540ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .book-cover-mark {
    display: grid;
    width: 1rem;
    height: 1rem;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--accent) 70%, transparent);
    border-radius: 999px;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.55rem;
    font-weight: 700;
  }

  .book-cover-rule {
    position: absolute;
    right: 0.35rem;
    bottom: 0.45rem;
    left: 0.35rem;
    height: 1px;
    background: color-mix(in srgb, var(--accent) 50%, transparent);
  }

  .book-spine {
    position: absolute;
    z-index: 8;
    top: 0.25rem;
    bottom: 0.25rem;
    left: calc(var(--book-hinge) - 0.1rem);
    width: 0.2rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 58%, var(--background));
    box-shadow: 0 0 0.3rem
      color-mix(in srgb, var(--foreground) 15%, transparent);
  }

  .bookshelf-portal:is(:hover, :focus-visible) .book {
    transform: translateX(0.875rem);
  }

  .bookshelf-portal:is(:hover, :focus-visible) .book-cover {
    z-index: 0;
    transform: translateZ(-3px) rotateY(-164deg);
  }

  .bookshelf-portal:is(:hover, :focus-visible) .book-page-one {
    animation: turn-page 620ms 130ms cubic-bezier(0.65, 0, 0.35, 1) forwards;
  }

  .bookshelf-portal:is(:hover, :focus-visible) .book-page-two {
    animation: turn-page 620ms 250ms cubic-bezier(0.65, 0, 0.35, 1) forwards;
  }

  .bookshelf-portal:is(:hover, :focus-visible) .book-page-three {
    animation: turn-page 620ms 370ms cubic-bezier(0.65, 0, 0.35, 1) forwards;
  }

  @keyframes turn-page {
    0% {
      transform: translateZ(var(--page-depth)) rotateY(0);
    }
    45% {
      transform: translateZ(var(--page-depth)) rotateY(-95deg);
    }
    100% {
      transform: translateZ(var(--page-depth)) rotateY(-164deg);
    }
  }

  @keyframes special-book-float {
    0%,
    100% {
      transform: translateY(-0.35rem) scale(1.16);
    }
    50% {
      transform: translateY(-0.75rem) scale(1.16);
    }
  }

  @keyframes floating-shadow {
    0%,
    100% {
      opacity: 0.5;
      transform: translateX(-50%) scaleX(1);
    }
    50% {
      opacity: 0.34;
      transform: translateX(-50%) scaleX(0.82);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bookshelf-portal,
    .floating-book-shadow {
      animation: none;
    }

    .bookshelf-portal {
      transform: translateY(-0.5rem) scale(1.16);
    }

    .book,
    .book-cover,
    .book-page {
      transition: none;
    }

    .bookshelf-portal:is(:hover, :focus-visible) .book {
      transform: none;
    }

    .bookshelf-portal:is(:hover, :focus-visible) .book-cover,
    .bookshelf-portal:is(:hover, :focus-visible) .book-page {
      animation: none;
      transform: translateZ(3px);
    }
  }
</style>
