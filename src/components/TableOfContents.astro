---
import type { MarkdownHeading } from "astro";
import { generateToc } from "@/utils/generateToc";
import TOCHeading from "@/components/TOCHeading.astro";

type Props = { headings: MarkdownHeading[]; lang?: string };
const { headings, lang = "en" } = Astro.props;
const pt = lang === "pt";
const label = pt ? "ÍNDICE" : "TABLE OF CONTENTS";
const toc = generateToc(
  headings.map(heading =>
    heading.slug === "footnote-label"
      ? { ...heading, text: pt ? "Notas de rodapé" : "Footnotes" }
      : heading
  )
);
---

{
  toc.length > 0 && (
    <post-toc class="post-toc" data-pagefind-ignore>
      <nav class="post-toc-desktop" aria-label={label}>
        <h2>{label}</h2>
        <ul>
          {toc.map(heading => (
            <TOCHeading {heading} {lang} />
          ))}
        </ul>
      </nav>
      <div class="post-toc-mobile" data-toc-dock>
        <button
          class="post-toc-toggle"
          data-toc-toggle
          type="button"
          aria-expanded="false"
          aria-label={pt ? "Mostrar índice" : "Show Table of Contents"}
        >
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <>
              <rect x="4" y="6" width="16" height="2" rx="1" />
              <rect x="4" y="11" width="16" height="2" rx="1" />
              <rect x="4" y="16" width="16" height="2" rx="1" />
            </>
          </svg>
        </button>
        <nav class="post-toc-popup" data-toc-popup aria-label={label} hidden>
          <h2>{label}</h2>
          <ul>
            {toc.map(heading => (
              <TOCHeading {heading} {lang} />
            ))}
          </ul>
        </nav>
      </div>
    </post-toc>
  )
}
